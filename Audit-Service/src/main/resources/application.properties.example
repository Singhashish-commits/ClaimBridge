spring.application.name=Audit-Service
server.port=${AUDIT_SERVICE_PORT}

spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.url=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${AUDIT_DB}
spring.datasource.username=${POSTGRES_USERNAME}
spring.datasource.password=${POSTGRES_PASSWORD}

spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=${DDL_AUTO}

jwt.secret.key=${JWT_SECRET_KEY}

eureka.client.service-url.defaultZone=${EUREKA_SERVER_URL}
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true

eureka.instance.prefer-ip-address=true
eureka.instance.ip-address=${SERVICE_IP}
eureka.instance.hostname=${SERVICE_HOSTNAME}
eureka.instance.instance-id=${spring.application.name}:${server.port}

spring.cloud.inetutils.preferred-networks=${PREFERRED_NETWORK}
spring.cloud.inetutils.ignored-interfaces=${IGNORED_INTERFACES}

spring.kafka.bootstrap-servers=${KAFKA_BOOTSTRAP_SERVERS}

spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer
spring.kafka.producer.properties.spring.json.add.type.headers=true